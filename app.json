{
  "expo": {
    "name": "MenTools",
    "slug": "MenTools",
    "owner": "mentools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "mentoolschallenges",
    "deepLinking": false,
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "googleClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9b465538-9a5a-49f0-9e0e-6f3f736ea793"
      }
    },
    "ios": {
      "UIBackgroundModes": ["remote-notification"],
      "supportsTablet": true,
      "bundleIdentifier": "com.mentools.challenges",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:invite.mentoolschallenges.co",
        "applinks:mentoolschallenges.co",
        "applinks:mentoolschallenges.app.link"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mentools.challenges",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mentoolschallenges"
            },
            {
              "scheme": "https",
              "host": "invite.mentoolschallenges.co"
            },
            {
              "scheme": "https",
              "host": "mentoolschallenges.co"
            },
            {
              "scheme": "https",
              "host": "mentoolschallenges.app.link"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      ["expo-apple-authentication"],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
